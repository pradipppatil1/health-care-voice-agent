# Google OAuth2 token files (generated by auth_setup.py)
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CLIENT_SECRET_FILE=client_secret.json

# Google Calendar — appointments calendar
GOOGLE_CALENDAR_ID=<<your email id>>

# Google Sheets — patient log sheet
GOOGLE_SHEET_ID=<<google sheet id>>

# Sheet tab name (change if your tab has a different name)
GOOGLE_SHEET_NAME=Appointments

# Timezone
TIMEZONE=Asia/Kolkata

# Server
PORT=8000

GOOGLE_API_KEY=<<your api key>>
MODEL_NAME = gemma-4-31b-it
